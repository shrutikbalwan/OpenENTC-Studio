{
  "name": "openentc-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An open-source, all-in-one ENTC learning and engineering workspace.",
  "scripts": {
    "dev": "node scripts/server.mjs",
    "build": "node scripts/build.mjs",
    "format:check": "node scripts/format-check.mjs",
    "lint": "node scripts/lint.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "worker:check": "python -m py_compile workers/python/worker.py",
    "desktop:check": "node scripts/desktop-check.mjs",
    "desktop:installer": "node scripts/desktop-check.mjs --installer",
    "desktop:launch-smoke": "node scripts/desktop-launch-smoke.mjs",
    "native:smoke": "node scripts/native-tool-smoke.mjs",
    "ngspice:smoke": "node scripts/ngspice-tool-smoke.mjs",
    "ngspice:integration": "node --test --experimental-test-isolation=none tests/ngspice.integration.test.mjs",
    "native:sbom": "node scripts/generate-native-sbom.mjs",
    "license:audit": "node scripts/audit-native-licenses.mjs",
    "phase:status": "node scripts/audit-phase-gates.mjs",
    "signing:check": "node scripts/check-signing.mjs",
    "release:prepare": "npm run build && npm run native:sbom && npm run license:audit",
    "browser:smoke": "node scripts/browser-performance-smoke.mjs",
    "release:verify": "node scripts/verify-release-bundle.mjs",
    "hdl:smoke": "node scripts/hdl-tool-smoke.mjs",
    "test": "node --test --experimental-test-isolation=none",
    "check": "npm run lint",
    "verify": "node scripts/verify.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "typescript": "5.9.2"
  }
}
