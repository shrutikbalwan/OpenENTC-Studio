{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenENTC Studio",
  "version": "0.1.0",
  "identifier": "org.openentc.studio",
  "build": {
    "beforeBuildCommand": "npm --prefix ../.. run build",
    "devUrl": "http://127.0.0.1:4181",
    "frontendDist": "../../../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenENTC Studio",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "dataDirectory": "webview-data"
      }
    ],
    "security": {
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
