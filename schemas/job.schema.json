{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openentc.org/schemas/job.schema.json",
  "title": "OpenENTC job",
  "type": "object",
  "required": ["id", "projectId", "operation", "state", "inputs", "outputs", "resourcePolicy", "createdAt", "updatedAt", "reproducibility", "diagnostics", "artifacts", "logs"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "projectId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "operation": { "type": "string", "minLength": 1, "maxLength": 200 },
    "adapter": { "type": ["string", "null"] },
    "engineVersion": { "type": ["string", "null"] },
    "state": { "enum": ["queued", "preparing", "running", "cancelling", "succeeded", "failed", "cancelled"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "startedAt": { "type": ["string", "null"], "format": "date-time" },
    "finishedAt": { "type": ["string", "null"], "format": "date-time" },
    "inputs": { "type": "array", "maxItems": 100000, "items": { "type": "string", "minLength": 1, "maxLength": 1000000 } },
    "outputs": { "type": "array", "maxItems": 100000, "items": { "type": "string", "minLength": 1, "maxLength": 1000000 } },
    "arguments": { "type": "array", "maxItems": 100000, "items": { "type": "string", "maxLength": 1000000 } },
    "resourcePolicy": { "type": "object", "maxProperties": 128, "additionalProperties": true },
    "reproducibility": { "type": "object", "required": ["inputs", "arguments"], "properties": { "inputs": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "arguments": { "type": "array", "maxItems": 100000, "items": { "type": "string", "maxLength": 1000000 } } }, "additionalProperties": true },
    "diagnostics": { "type": "array", "items": { "type": "object" } },
    "artifacts": { "type": "array", "maxItems": 100000, "items": { "type": "object", "required": ["path", "sha256", "size", "mediaType"], "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\u0000-\\u001F\\u007F]+$" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "size": { "type": "integer", "minimum": 0, "maximum": 268435456 }, "mediaType": { "type": "string", "minLength": 1, "maxLength": 200 } }, "additionalProperties": true } },
    "logs": { "type": "array", "maxItems": 10000 }
  },
  "additionalProperties": true
}
