{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openentc.org/schemas/artifact-manifest.schema.json",
  "title": "OpenENTC artifact manifest",
  "type": "object",
  "required": ["format", "version", "tool", "toolVersion", "generatedAt", "artifacts"],
  "properties": {
    "format": { "const": "openentc-artifact-manifest" },
    "version": { "const": 1 },
    "tool": { "type": "string", "minLength": 1, "maxLength": 200 },
    "toolVersion": { "type": "string", "minLength": 1, "maxLength": 200 },
    "generatedAt": { "type": ["string", "null"], "format": "date-time" },
    "artifacts": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size", "mediaType"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\u0000-\\u001F\\u007F]+$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size": { "type": "integer", "minimum": 0, "maximum": 268435456 },
          "mediaType": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
