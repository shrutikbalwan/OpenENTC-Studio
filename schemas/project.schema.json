{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openentc.org/schemas/project.schema.json",
  "title": "OpenENTC project manifest",
  "type": "object",
  "required": ["format", "version", "name", "createdAt", "updatedAt", "circuit", "embedded", "documents", "targets", "toolchainConstraints", "experiments", "notes", "settings"],
  "properties": {
    "format": { "const": "openentc-project" },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "circuit": {
      "type": "object",
      "required": ["components", "wires", "signal", "junctions", "netLabels"],
      "properties": {
        "wires": {
          "type": "array",
          "maxItems": 100000,
          "items": { "type": "object", "required": ["from", "to"], "properties": { "from": { "type": "string", "minLength": 1, "maxLength": 100 }, "to": { "type": "string", "minLength": 1, "maxLength": 100 }, "route": { "$ref": "#/$defs/wireRoute" } }, "additionalProperties": true }
        },
        "junctions": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/junction" } },
        "netLabels": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/netLabel" } },
        "components": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/component" }
        },
        "signal": { "$ref": "#/$defs/signal" }
      },
      "additionalProperties": true
    },
    "artifacts": { "type": "array", "maxItems": 100000, "items": { "type": "object", "required": ["path", "sha256", "size", "mediaType"], "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\u0000-\\u001F\\u007F]+$" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "size": { "type": "integer", "minimum": 0, "maximum": 268435456 }, "mediaType": { "type": "string", "minLength": 1, "maxLength": 200 } }, "additionalProperties": true } },
    "units": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "provenance": { "type": "object", "required": ["createdBy", "engineVersions"], "properties": { "createdBy": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" }, "engineVersions": { "type": "object", "maxProperties": 1000, "propertyNames": { "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" }, "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" } } }, "additionalProperties": true },
    "documents": { "type": "array", "maxItems": 1000, "items": { "type": "object", "additionalProperties": true } },
    "targets": { "type": "array", "maxItems": 1000, "items": { "type": "object", "additionalProperties": true } },
    "toolchainConstraints": { "type": "array", "maxItems": 1000, "items": { "type": "object", "additionalProperties": true } },
    "experiments": { "type": "array", "maxItems": 10000, "items": { "type": "object", "additionalProperties": true } },
    "embedded": {
      "type": "object",
      "required": ["board", "language", "code"],
      "properties": {
        "board": { "type": "string", "maxLength": 200 },
        "language": { "type": "string", "maxLength": 50 },
        "code": { "type": "string", "maxLength": 1000000 }
      },
      "additionalProperties": true
    },
    "notes": { "type": "array", "maxItems": 1000 },
    "settings": { "type": "object", "required": ["gridSize"], "properties": { "gridSize": { "type": "integer", "minimum": 1, "maximum": 200 } }, "additionalProperties": true }
  },
  "additionalProperties": true,
  "$defs": {
    "wireRoute": {
      "oneOf": [
        { "type": "object", "required": ["axis", "coordinate"], "properties": { "axis": { "enum": ["x", "y"] }, "coordinate": { "type": "number", "minimum": -1000000, "maximum": 1000000 } }, "additionalProperties": false },
        { "type": "object", "required": ["points"], "properties": { "points": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/wirePoint" } } }, "additionalProperties": false }
      ]
    },
    "wirePoint": {
      "type": "object",
      "required": ["x", "y"],
      "properties": { "x": { "type": "number", "minimum": -1000000, "maximum": 1000000 }, "y": { "type": "number", "minimum": -1000000, "maximum": 1000000 } },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": ["id", "type", "label", "value", "unit", "n1", "n2", "x", "y"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
        "type": { "type": "string", "maxLength": 50 },
        "label": { "type": "string", "maxLength": 100 },
        "value": { "type": "number", "finite": true },
        "unit": { "type": "string", "maxLength": 20 },
        "n1": { "type": "string", "maxLength": 100 },
        "n2": { "type": "string", "maxLength": 100 },
        "n3": { "type": "string", "maxLength": 100 },
        "kp": { "type": "number" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "rotation": { "type": "number" }
      },
      "additionalProperties": true
    },
    "junction": {
      "type": "object",
      "required": ["id", "node", "x", "y"],
      "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 100 }, "node": { "type": "string", "minLength": 1, "maxLength": 100 }, "x": { "type": "number" }, "y": { "type": "number" } },
      "additionalProperties": true
    },
    "netLabel": {
      "type": "object",
      "required": ["id", "text", "node", "x", "y"],
      "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 100 }, "text": { "type": "string", "minLength": 1, "maxLength": 100 }, "node": { "type": "string", "minLength": 1, "maxLength": 100 }, "x": { "type": "number" }, "y": { "type": "number" } },
      "additionalProperties": true
    },
    "signal": {
      "type": "object",
      "required": ["shape", "frequency", "amplitude", "offset"],
      "properties": {
        "shape": { "enum": ["sine", "square", "triangle"] },
        "frequency": { "type": "number", "exclusiveMinimum": 0 },
        "amplitude": { "type": "number" },
        "offset": { "type": "number" }
      },
      "additionalProperties": true
    }
  }
}
