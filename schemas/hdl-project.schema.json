{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openentc.org/schemas/hdl-project.schema.json",
  "title": "OpenENTC HDL project document",
  "type": "object",
  "required": ["format", "version", "name", "sourceSets", "topUnit", "constraints", "targets"],
  "properties": {
    "format": { "const": "openentc-hdl-project" },
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "topUnit": { "type": ["string", "null"], "maxLength": 200 },
    "sourceSets": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/sourceSet" } },
    "constraints": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/constraint" } },
    "targets": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/target" } }
  },
  "additionalProperties": true,
  "$defs": {
    "path": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!\\\\)(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.{1,2}(?:[\\\\/]|$))[^\\u0000-\\u001F\\u007F]+$" },
    "id": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" },
    "sourceSet": {
      "type": "object",
      "required": ["id", "language", "sources"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "language": { "enum": ["verilog", "systemverilog", "vhdl"] },
        "sources": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/source" } }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": ["path", "kind"],
      "properties": { "path": { "$ref": "#/$defs/path" }, "kind": { "enum": ["source", "testbench"] } },
      "additionalProperties": true
    },
    "constraint": {
      "type": "object",
      "required": ["id", "path"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "path": { "$ref": "#/$defs/path" } },
      "additionalProperties": true
    },
    "target": {
      "type": "object",
      "required": ["id", "family"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "family": { "enum": ["generic", "ice40"] }, "device": { "type": "string", "maxLength": 200 } },
      "additionalProperties": true
    }
  }
}
