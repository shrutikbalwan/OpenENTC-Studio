{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openentc.org/schemas/capability-verification.schema.json",
  "title": "OpenENTC capability verification ledger",
  "type": "object",
  "required": ["ledgerVersion", "auditedAt", "statuses", "capabilities"],
  "properties": {
    "ledgerVersion": { "type": "integer", "minimum": 1 },
    "auditedAt": { "type": "string", "format": "date" },
    "statuses": { "const": ["software-verified", "emulator-verified", "hardware-unverified", "hardware-verified"] },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "software", "emulator", "hardware", "evidence", "scope"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
          "software": { "enum": ["software-verified", null] },
          "emulator": { "enum": ["emulator-verified", null] },
          "hardware": { "enum": ["hardware-unverified", "hardware-verified", null] },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "scope": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
