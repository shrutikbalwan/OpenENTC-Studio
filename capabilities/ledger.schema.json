{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openentc.org/schemas/capability-ledger.schema.json",
  "title": "OpenENTC capability ledger",
  "type": "object",
  "required": ["ledgerVersion", "productVersion", "auditedAt", "states", "capabilities"],
  "properties": {
    "$schema": { "type": "string" },
    "ledgerVersion": { "type": "integer", "minimum": 1 },
    "productVersion": { "type": "string", "minLength": 1 },
    "auditedAt": { "type": "string", "format": "date" },
    "states": {
      "type": "array",
      "const": ["built-in", "integrated", "interoperable", "unavailable", "unsupported"]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "surface", "state", "evidence", "limitations", "plannedPhase"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
          "surface": { "type": "string", "minLength": 1 },
          "state": { "enum": ["built-in", "integrated", "interoperable", "unavailable", "unsupported"] },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "limitations": { "type": "string", "minLength": 1 },
          "plannedPhase": { "type": ["integer", "null"], "minimum": 1, "maximum": 13 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
